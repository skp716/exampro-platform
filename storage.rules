rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSuperAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }
    match /institute-logos/{instituteId}/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}
