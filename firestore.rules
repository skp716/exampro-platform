rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Legacy/platform collections stay unavailable to tenant administrators.
    function isAdmin() {
      return hasActiveAdminProfile()
        && (!('instituteId' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.instituteId == '' || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin')
        && (!('role' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin','super_admin']);
    }

    // Platform owner. Existing active admins continue to use the legacy Admin
    // Panel; only an explicitly assigned role can enter the Super Admin layer.
    function isSuperAdmin() {
      return hasActiveAdminProfile()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    function instituteActive(instituteId) {
      return exists(/databases/$(database)/documents/institutes/$(instituteId)) && get(/databases/$(database)/documents/institutes/$(instituteId)).data.status == 'active';
    }
    function isMember(instituteId) {
      return signedIn() && instituteActive(instituteId) && exists(/databases/$(database)/documents/institutes/$(instituteId)/members/$(request.auth.uid));
    }
    function ownsLock(id, instituteId) {
      return signedIn() && exists(/databases/$(database)/documents/attempt_locks/$(id)) && get(/databases/$(database)/documents/attempt_locks/$(id)).data.ownerUid == request.auth.uid && get(/databases/$(database)/documents/attempt_locks/$(id)).data.instituteId == instituteId;
    }
    function tenantEntryOpen(instituteId, examId) {
      let settings = get(/databases/$(database)/documents/institutes/$(instituteId)/settings/exam_config).data;
      return get(/databases/$(database)/documents/institutes/$(instituteId)/exams/$(examId)).data.active == true
        && (!('entryStartAt' in settings) || settings.entryStartAt == null || request.time >= settings.entryStartAt)
        && (!('entryCloseAt' in settings) || settings.entryCloseAt == null || request.time <= settings.entryCloseAt);
    }
    function isInstituteAdmin(instituteId) {
      return hasActiveAdminProfile() && instituteActive(instituteId)
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.instituteId == instituteId
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['institute_admin', 'admin'];
    }

    function validAttemptLock() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'email', 'examId', 'instituteId', 'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.examId is string
        && request.resource.data.examId.size() > 0
        && request.resource.data.examId.size() <= 80
        && request.resource.data.instituteId is string
        && (request.resource.data.instituteId == '' || (isMember(request.resource.data.instituteId) && tenantEntryOpen(request.resource.data.instituteId, request.resource.data.examId)))
        && request.resource.data.createdAt is timestamp;
    }

    function validResultIdentity(resultId) {
      return signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.attemptId is string
        && request.resource.data.attemptId == resultId
        && request.resource.data.email is string
        && request.resource.data.examId is string;
    }

    function validSessionStatusTransition() {
      return request.resource.data.status in ['logged_in', 'in_progress', 'result_pending_feedback', 'final_submitted']
        && (
          (resource.data.status == 'logged_in' && request.resource.data.status in ['logged_in', 'in_progress']) ||
          (resource.data.status == 'in_progress' && request.resource.data.status in ['in_progress', 'result_pending_feedback']) ||
          (resource.data.status == 'result_pending_feedback' && request.resource.data.status in ['result_pending_feedback', 'final_submitted'])
        );
    }

    // Admin membership is provisioned from Firebase Console/Admin SDK only.
    match /admins/{adminId} {
      // Super Admin must be able to inspect a target profile before safely
      // creating/updating Institute Admin access. Other admins can read only
      // their own authorization profile.
      allow get: if (signedIn() && request.auth.uid == adminId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      // Account creation itself belongs to Firebase Auth/Admin SDK. Super Admin
      // may manage only the matching authorization profile in Firestore.
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // Globally unique, normalized institute-code reservation. Students never
    // list this collection; the future gateway will resolve only an exact code.
    match /institute_codes/{codeId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /institutes/{instituteId} {
      allow get: if isSuperAdmin() || isInstituteAdmin(instituteId) || isMember(instituteId);
      allow list, create, update: if isSuperAdmin();
      allow delete: if false;
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /configuration_versions/{versionId} {
        allow read: if isSuperAdmin() || isInstituteAdmin(instituteId);
        allow create: if isSuperAdmin();
        allow update, delete: if false;
      }
      match /students/{id} { allow read, write: if isInstituteAdmin(instituteId); }
      match /batches/{id} { allow read, write: if isInstituteAdmin(instituteId); }
      match /exams/{id} {
        allow read: if isSuperAdmin() || isInstituteAdmin(instituteId) || isMember(instituteId);
        allow write: if isInstituteAdmin(instituteId);
      }
      match /question_bank/{id} {
        allow read: if isInstituteAdmin(instituteId) || isMember(instituteId);
        allow write: if isInstituteAdmin(instituteId);
      }
      match /settings/{id} {
        allow read: if isSuperAdmin() || isInstituteAdmin(instituteId) || isMember(instituteId);
        allow write: if isInstituteAdmin(instituteId);
      }
      match /centers/{id} {
        allow read: if isInstituteAdmin(instituteId) || isMember(instituteId);
        allow write: if isInstituteAdmin(instituteId);
      }
      match /results/{id} {
        allow get: if isInstituteAdmin(instituteId) || (isMember(instituteId) && ownsLock(id,instituteId) && (!exists(/databases/$(database)/documents/institutes/$(instituteId)/results/$(id)) || resource.data.ownerUid == request.auth.uid));
        allow list: if isInstituteAdmin(instituteId);
        allow create: if isMember(instituteId) && ownsLock(id,instituteId) && validResultIdentity(id) && request.resource.data.instituteId == instituteId
          && request.resource.data.status == 'draft' && request.resource.data.completed == false
          && get(/databases/$(database)/documents/institutes/$(instituteId)/exam_sessions/$(id)).data.status in ['in_progress','result_pending_feedback'];
        allow update: if isMember(instituteId) && ownsLock(id,instituteId) && resource.data.completed == false && validResultIdentity(id)
          && resource.data.ownerUid == request.auth.uid && request.resource.data.instituteId == instituteId
          && request.resource.data.examId == resource.data.examId && request.resource.data.email == resource.data.email
          && request.resource.data.status in ['draft','completed']
          && (request.resource.data.completed == false || getAfter(/databases/$(database)/documents/institutes/$(instituteId)/exam_sessions/$(id)).data.status == 'final_submitted');
        allow delete: if false; // Retakes are an atomic server operation.
      }
      match /exam_sessions/{id} {
        allow get: if isInstituteAdmin(instituteId) || (isMember(instituteId) && (!exists(/databases/$(database)/documents/institutes/$(instituteId)/exam_sessions/$(id)) || resource.data.ownerUid == request.auth.uid));
        allow list: if isInstituteAdmin(instituteId);
        allow create: if isMember(instituteId) && ownsLock(id,instituteId)
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.instituteId == instituteId && request.resource.data.sessionId == id
          && request.resource.data.email == get(/databases/$(database)/documents/attempt_locks/$(id)).data.email
          && request.resource.data.examId == get(/databases/$(database)/documents/attempt_locks/$(id)).data.examId
          && request.resource.data.status in ['logged_in','in_progress','result_pending_feedback'];
        allow update: if isMember(instituteId) && ownsLock(id,instituteId) && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.instituteId == instituteId
          && request.resource.data.examId == resource.data.examId && request.resource.data.email == resource.data.email
          && request.resource.data.sessionId == id && resource.data.status != 'final_submitted'
          && validSessionStatusTransition()
          && (request.resource.data.status != 'final_submitted' || getAfter(/databases/$(database)/documents/institutes/$(instituteId)/results/$(id)).data.completed == true);
        allow delete: if false;
        match /snapshot/{part} {
          allow read: if isMember(instituteId) && ownsLock(id,instituteId);
          allow create: if isMember(instituteId) && ownsLock(id,instituteId)
            && get(/databases/$(database)/documents/institutes/$(instituteId)/exam_sessions/$(id)).data.status in ['logged_in','in_progress','result_pending_feedback']
            && !('snapshotParts' in get(/databases/$(database)/documents/institutes/$(instituteId)/exam_sessions/$(id)).data);
          allow update, delete: if false;
        }
      }
    }

    match /audit_logs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /exam_config/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Center codes are stored only as SHA-256 document IDs. Students can
    // validate an entered code by exact document lookup but cannot list codes.
    match /centers/{centerId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // One deterministic document per email + exam. Student clients may create
    // a lock exactly once; only an admin can remove it to grant a retake.
    match /attempt_locks/{attemptId} {
      allow create: if validAttemptLock();
      allow get: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // One live row per student/exam. It starts as logged_in, becomes
    // in_progress, and is finalized in-place so the admin sees live status.
    match /exam_sessions/{sessionId} {
      allow get: if signedIn()
        && (
          isAdmin() || (
            exists(/databases/$(database)/documents/attempt_locks/$(sessionId))
            && get(/databases/$(database)/documents/attempt_locks/$(sessionId)).data.ownerUid == request.auth.uid
          )
        );
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.status == 'logged_in'
        && request.resource.data.email is string
        && request.resource.data.examId is string
        && request.resource.data.centerId is string;
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.email == resource.data.email
        && request.resource.data.examId == resource.data.examId
        && request.resource.data.centerId == resource.data.centerId
        && resource.data.status != 'final_submitted'
        && validSessionStatusTransition()
        && (request.resource.data.status != 'final_submitted' || (
          exists(/databases/$(database)/documents/results/$(sessionId))
          && get(/databases/$(database)/documents/results/$(sessionId)).data.completed == true
        ))
      );
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow create: if validResultIdentity(resultId)
        && request.resource.data.status == 'draft'
        && request.resource.data.completed == false
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'ownerUid', 'attemptId', 'examId', 'examName',
          'subjects', 'instituteId', 'studentProfile', 'score', 'correct', 'wrong', 'tabSwitches',
          'copiesAttempted', 'penaltiesApplied', 'feedback', 'doubt',
          'rating', 'status', 'completed', 'submittedAt', 'updatedAt'
        ]);

      allow get: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      // A student can only finish their own draft. Identity and exam fields
      // cannot be swapped, and a completed result cannot be edited again.
      allow update: if isAdmin() || (
        validResultIdentity(resultId)
        && resource.data.ownerUid == request.auth.uid
        && resource.data.attemptId == request.resource.data.attemptId
        && resource.data.email == request.resource.data.email
        && resource.data.examId == request.resource.data.examId
        && resource.data.completed == false
        && request.resource.data.completed == true
        && request.resource.data.status == 'completed'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'ownerUid', 'attemptId', 'examId', 'examName',
          'subjects', 'instituteId', 'studentProfile', 'score', 'correct', 'wrong', 'tabSwitches',
          'copiesAttempted', 'penaltiesApplied', 'feedback', 'doubt',
          'rating', 'status', 'completed', 'submittedAt', 'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
